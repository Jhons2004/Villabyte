# VILLABYTE - configuracion privada. Copiar a .env y NO subir .env al repositorio.
NODE_ENV=development
PORT=3000

# PostgreSQL dedicado a Villabyte. No reutilizar otras bases institucionales.
DATABASE_URL=

# Credenciales del administrador: establecer valores seguros ANTES de publicar.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Al menos 32 caracteres aleatorios.
SESSION_SECRET=

# Correos transaccionales vía API HTTP de Resend (dominio/remitente verificados).
# Recibe un aviso al registrar un servicio y permite contestar desde el CMS.
RESEND_API_KEY=
MAIL_FROM=
NOTIFY_EMAIL=
