# Villabyte | configuración privada. Copia como .env; nunca publiques .env.
NODE_ENV=development
PORT=3000

# PostgreSQL Neon del proyecto exclusivo Villabyte, NO DSNC ni Worklink.
DATABASE_URL=

# Administrador del panel Villabyte (clave fuerte, exclusiva).
ADMIN_EMAIL=jonasvillavicencio845@gmail.com
ADMIN_PASSWORD=
SESSION_SECRET=

# Google Apps Script existente - MailApp, no SMTP directo.
# La ruta /u/1/ depende de la sesión del navegador, no se usa en el backend.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbznNNt_-UqwNrL9XDnodbrfHi9KrHtCH8xRONz7N7seKT1jSPARnPR2mycLCT1Sk-RR/exec

# Debe coincidir con API_KEY en Script Properties de Apps Script.
# Generar una clave aleatoria NUEVA; no usar la clave de ejemplo divulgada.
GOOGLE_APPS_SCRIPT_KEY=

# Solo activar al publicar el script actualizado villabyte-mail-v2.gs.
# Esta segunda clave debe coincidir con REPLY_API_KEY en Script Properties.
GOOGLE_SCRIPT_REPLY_ENABLED=false
GOOGLE_APPS_SCRIPT_REPLY_KEY=

# En Apps Script Script Properties:
# DESTINATION_EMAIL=jonasvillavicencio845@gmail.com
# SENDER_NAME=Villabyte | Atención comercial
# SITE_NAME=Villabyte
